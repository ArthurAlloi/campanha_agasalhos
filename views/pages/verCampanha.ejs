<!DOCTYPE html>
<html lang="pt-br">
  <%- include("../partials/head"); %>

  <body>
    <%- include("../partials/loader") %>
    <script src="/js/loader.js" defer></script>
    <%- include("../partials/menu"); %>

    <div id="header-space"></div>

    <main class="page-campanha-view solu-main">

      <!-- Título real da campanha -->
      <h1 class="page-title"><%= campanha.nome %></h1>

      <% Object.keys(turmasDoacoes).forEach(turmaId => { %>
        <section class="turma-section">

          <!-- Nome da Turma (colapsável) -->
          <h2 class="turma-title" data-toggle="collapse">
            <%= turmasDoacoes[turmaId].sigla %>
          </h2>

          <!-- Conteúdo colapsável -->
          <div class="turma-table-wrap">
            <table class="table-simple">

              <thead>
                <tr>
                  <th>Item</th>
                  <th>Quantidade</th>
                  <th>Pontos</th>
                </tr>
              </thead>

              <tbody>
                <% turmasDoacoes[turmaId].itens.forEach(i => { %>
                  <tr>
                    <td><%= i.nome %></td>
                    <td><%= i.quantidade %></td>
                    <td><%= i.pontos %></td>
                  </tr>
                <% }) %>
              </tbody>

            </table>
          </div>

        </section>
      <% }) %>

      <div class="form-actions" style="margin-top:18px;">
        <button class="btn btn-secondary" onclick="window.location.href='/tabela'">Voltar</button>
      </div>

    </main>

    <div id="header-space"></div>

    <script>
      // Collapse por turma
      document.querySelectorAll('.turma-title').forEach(h2 => {
        h2.style.cursor = 'pointer';
        h2.addEventListener('click', () => {
          const wrap = h2.nextElementSibling;
          if (!wrap) return;

          wrap.style.display = wrap.style.display === 'none' ? '' : 'none';
          h2.classList.toggle('collapsed');
        });
      });
    </script>

    <script src="/static/js/main.js"></script>
  </body>
</html>
