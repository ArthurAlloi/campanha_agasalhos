<!DOCTYPE html>
<html lang="pt-br">
  <%- include("../partials/head"); %>

  <body>
    <%- include("../partials/menu"); %>

    <main class="solu-main">
      <h1 class="solu-title">Gerenciamento de Usuários</h1>

      <!-- Formulário de criação -->
      <form action="/usuariosadm/criar" method="POST" class="solu-form">
        <h3 class="solu-subtitle">Criar novo usuário</h3>

        <input type="text" name="cpf" id="cpf" placeholder="CPF" required maxlength="14">
        <input type="email" name="email" placeholder="E-mail" required maxlength="100">
        <input type="password" name="password" placeholder="Senha" required maxlength="50">

        <label for="adm">Nível de Acesso:</label>
        <select name="adm" id="adm">
          <option value="0">Usuário</option>
          <option value="2">Mini Admin</option>
          <option value="1">Admin</option>
        </select>

        <label>
          <input type="checkbox" name="ativo" value="1" checked> Ativo
        </label>

        <button type="submit">Criar</button>
      </form>

      <hr>

      <!-- Tabela de usuários -->
      <h3 class="solu-subtitle">Usuários cadastrados</h3>
      <table class="solu-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>CPF</th>
            <th>Email</th>
            <th>Nível de Acesso</th>
            <th>Ativo</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
            <tr>
              <td><%= user.id %></td>
              <td><%= user.cpf %></td>
              <td><%= user.email %></td>
              <td>
                <% if(user.adm === 0){ %>Usuário<% } %>
                <% if(user.adm === 2){ %>Mini Admin<% } %>
                <% if(user.adm === 1){ %>Admin<% } %>
              </td>
              <td><%= user.ativo ? 'Sim' : 'Não' %></td>
              <td class="action-cell">
                <!-- Editar -->
                <form action="/usuariosadm/editar/<%= user.id %>" method="POST" style="margin-bottom:5px;">
                  <input type="text" name="cpf" value="<%= user.cpf %>" required maxlength="14">
                  <input type="email" name="email" value="<%= user.email %>" required maxlength="100">
                  <input type="password" name="password" placeholder="Nova senha" maxlength="50">

                  <label for="adm_<%= user.id %>">Nível de Acesso:</label>
                  <select name="adm" id="adm_<%= user.id %>">
                    <option value="0" <%= user.adm === 0 ? 'selected' : '' %>>Usuário</option>
                    <option value="2" <%= user.adm === 2 ? 'selected' : '' %>>Mini Admin</option>
                    <option value="1" <%= user.adm === 1 ? 'selected' : '' %>>Admin</option>
                  </select>

                  <label>
                    <input type="checkbox" name="ativo" value="1" <%= user.ativo ? 'checked' : '' %>> Ativo
                  </label>

                  <button type="submit">Salvar</button>
                </form>

                <!-- Deletar -->
                <form action="/usuariosadm/deletar/<%= user.id %>" method="POST">
                  <button type="submit" onclick="return confirm('Tem certeza que deseja excluir este usuário?')">Excluir</button>
                </form>

              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </main>

    <script src="//code.jquery.com/jquery-3.6.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script>
      $('#cpf').mask('000.000.000-00', {reverse: true});
    </script>
  </body>
</html>
