<!DOCTYPE html>
<html lang="pt-br">
  <%- include("../partials/head"); %>

  <body>
    <%- include("../partials/menu"); %>

    <main class="solu-main">
      <h1 class="solu-title">Gerenciamento de Usuários</h1>

      <!-- Formulário de criação -->
      <form action="/usuariosadm/criar" method="POST" class="solu-form">
        <h3 class="solu-subtitle">Criar novo usuário</h3>
        <input type="text" name="cpf" id="cpf" placeholder="CPF" required>
        <input type="email" name="email" placeholder="E-mail" required>
        <input type="password" name="password" placeholder="Senha" required>
        <label>
          <input type="checkbox" name="adm" value="1"> Administrador
        </label>
        <label>
          <input type="checkbox" name="ativo" value="1" checked> Ativo
        </label>
        <button type="submit">Criar</button>
      </form>

      <hr>

      <!-- Tabela de usuários -->
      <h3 class="solu-subtitle">Usuários cadastrados</h3>
      <table class="solu-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>CPF</th>
            <th>Email</th>
            <th>Administrador</th>
            <th>Ativo</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
            <tr>
              <td><%= user.id %></td>
              <td><%= user.cpf %></td>
              <td><%= user.email %></td>
              <td><%= user.adm ? 'Sim' : 'Não' %></td>
              <td><%= user.ativo ? 'Sim' : 'Não' %></td>

              <td class="action-cell">
                <!-- Editar -->
                <form action="/usuariosadm/editar/<%= user.id %>" method="POST">
                  <input type="text" name="cpf" value="<%= user.cpf %>" required>
                  <input type="email" name="email" value="<%= user.email %>" required>
                  <input type="password" name="password" placeholder="Nova senha">
                  <label>
                    <input type="checkbox" name="adm" value="1" <%= user.adm ? 'checked' : '' %>> Adm
                  </label>
                  <label>
                    <input type="checkbox" name="ativo" value="1" <%= user.ativo ? 'checked' : '' %>> Ativo
                  </label>
                  <button type="submit">Salvar</button>

                  <!-- Deletar -->
                  <form action="/usuariosadm/deletar/<%= user.id %>" method="POST">
                    <button type="submit" onclick="return confirm('Tem certeza que deseja excluir este usuário?')">Excluir</button>
                  </form>

                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </main>

    <script src="//code.jquery.com/jquery-3.6.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.js" integrity="sha512-0XDfGxFliYJPFrideYOoxdgNIvrwGTLnmK20xZbCAvPfLGQMzHUsaqZK8ZoH+luXGRxTrS46+Aq400nCnAT0/w==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script> $('#cpf').mask('000.000.000-00', {reverse: true}); </script>

  </body>
</html>
