<!DOCTYPE html>
<html lang="pt-br">
  <%- include("../partials/head"); %>

  <body>
    <%- include("../partials/menu"); %>

    <main class="page-doacoes">
      <header class="page-header">
        <h1 class="page-title">Doações</h1>
        <p class="page-lead">Escolha uma ação abaixo</p>
      </header>

      <section class="actions-grid">
        <article class="action-card">
          <a class="action-link" href="/tabela" title="Exibir Tabela de Doações">
            <img class="action-img" src="../static/Img/tabela.png" alt="Tabela de Doações">
            <h3 class="action-title">Exibir Tabela de Doações</h3>
          </a>
        </article>

        <% if (req.session.user) { %>
          <article class="action-card">
            <a class="action-link" href="/criarcampanha" title="Criar Campanha">
              <img class="action-img" src="../static/Img/doar.jpg" alt="Criar Campanha">
              <h3 class="action-title">Criar Campanha</h3>
            </a>
          </article>
        <% } %>
      </section>
    </main>

    <%- include("../partials/footer"); %>
  </body>
</html>
