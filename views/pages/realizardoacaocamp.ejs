<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Realizar Doação</title>
</head>
<body>
  <h1>Registrar Doação</h1>

  <form action="/realizardoacao" method="POST">
    <!-- CAMPANHA -->
    <label for="campanha">Campanha:</label>
    <select id="campanha" name="id_campanha" required>
      <option value="">— selecione uma campanha —</option>
      <% campanhas.forEach(c => { %>
        <option value="<%= c.id %>" <%= (Number(idCampanhaSelecionada) === c.id) ? 'selected' : '' %>>
          <%= c.nome %>
        </option>
      <% }) %>
    </select>
    <br><br>

    <!-- TURMA -->
    <label for="turma">Turma:</label>
    <select id="turma" name="id_turma" required>
      <option value="">— selecione uma turma —</option>
      <% turmas.forEach(t => { %>
        <option value="<%= t.id %>"><%= t.sigla || t.nome %></option>
      <% }) %>
    </select>
    <br><br>

    <!-- ITEM / ROUPA -->
    <label for="roupa">Item:</label>
    <select id="roupa" name="id_roupa" required>
      <option value="">— selecione um item —</option>
      <% roupas.forEach(r => { %>
        <option value="<%= r.id %>" data-campanha="<%= r.id_campanha %>">
          <%= r.nome_item || r.nome %> — <%= r.pontos %> pts
        </option>
      <% }) %>
    </select>
    <br><br>

    <!-- QUANTIDADE -->
    <label for="quantidade">Quantidade:</label>
    <input type="number" id="quantidade" name="quantidade" min="1" required>
    <br><br>

    <button type="submit">Salvar Doação</button>
  </form>

  <!-- Script para filtrar itens de acordo com a campanha selecionada -->
  <script>
    const campanhaSelect = document.getElementById('campanha');
    const roupaSelect = document.getElementById('roupa');
    const allOptions = Array.from(roupaSelect.querySelectorAll('option[data-campanha]'));

    campanhaSelect.addEventListener('change', () => {
      const selectedCampanha = campanhaSelect.value;

      // Limpa o dropdown de itens
      roupaSelect.innerHTML = '<option value="">— selecione um item —</option>';

      // Adiciona apenas os itens da campanha selecionada
      allOptions.forEach(opt => {
        if (opt.dataset.campanha === selectedCampanha) {
          roupaSelect.appendChild(opt);
        }
      });
    });

    // Dispara o filtro caso já venha com campanha selecionada
    if (campanhaSelect.value) {
      campanhaSelect.dispatchEvent(new Event('change'));
    }
  </script>
</body>
</html>
