<!DOCTYPE html>
<html lang="pt-br">
<%- include("../partials/head"); %>
  <%- include("../partials/menu"); %>


    <body>
      <main class="page-doacao-registrar solu-main">

        <form id="form-doacao" class="form-campanha" action="/realizardoacao" method="POST"
          onsubmit="return validarQuantidade()">

          <div>
            <h1 class="page-title">Registrar Doação</h1>
          </div>

          <div class="form-row">
            <!-- CAMPANHA -->
            <div class="form-col">
              <label for="campanha" class="form-label">Campanha:</label>
              <select id="campanha" name="id_campanha" class="select" required>
                <option value="">— selecione uma campanha —</option>
                <% campanhas.forEach(c=> { %>
                  <option value="<%= c.id %>" <%=(Number(idCampanhaSelecionada)===c.id) ? 'selected' : '' %>>
                    <%= c.nome %>
                  </option>
                  <% }) %>
              </select>
            </div>

            <!-- TURMA -->
            <div class="form-col">
              <label for="turma" class="form-label">Turma:</label>
              <select id="turma" name="id_turma" class="select" required>
                <option value="">— selecione uma turma —</option>
                <% turmas.forEach(t=> { %>
                  <option value="<%= t.id %>">
                    <%= t.sigla || t.nome %>
                  </option>
                  <% }) %>
              </select>
            </div>
          </div>

          <!-- ITEM -->
          <div class="form-row">
            <div class="form-col">
              <label for="roupa" class="form-label">Item:</label>
              <select id="roupa" name="id_roupa" class="select" required>
                <option value="">— selecione um item —</option>
                <% roupas.forEach(r=> { %>
                  <option value="<%= r.id %>" data-campanha="<%= r.id_campanha %>">
                    <%= r.nome_item || r.nome %> — <%= r.pontos %> pts
                  </option>
                  <% }) %>
              </select>
            </div>

            <!-- QUANTIDADE -->
            <div class="form-col">
              <label for="quantidade" class="form-label">Quantidade:</label>
              <input 
              type="number" 
              id="quantidade" 
              name="quantidade" 
              min="1" max="99" 
              required 
              class="input"
              placeholder="1 a 99">
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Salvar Doação</button>
          </div>
        </form>
      </main>

      <!-- Script para filtrar itens -->
      <script>
        const campanhaSelect = document.getElementById('campanha');
        const roupaSelect = document.getElementById('roupa');
        const allOptions = Array.from(roupaSelect.querySelectorAll('option[data-campanha]'));

        campanhaSelect.addEventListener('change', () => {
          const selectedCampanha = campanhaSelect.value;
          roupaSelect.innerHTML = '<option value="">— selecione um item —</option>';

          allOptions.forEach(opt => {
            if (opt.dataset.campanha === selectedCampanha) {
              roupaSelect.appendChild(opt);
            }
          });
        });

        if (campanhaSelect.value) {
          campanhaSelect.dispatchEvent(new Event('change'));
        }

        // --------------------------
        // ❗ LIMITAR QUANTIDADE 1–99
        // --------------------------
        const qty = document.getElementById("quantidade");

        qty.addEventListener("input", () => {
          let v = Number(qty.value);

          if (v > 99) qty.value = 99;
          if (v < 1) qty.value = 1;
        });

        // Validação final do form
        function validarQuantidade() {
          const v = Number(qty.value);

          if (isNaN(v) || v < 1 || v > 99) {
            alert("A quantidade precisa ser entre 1 e 99.");
            return false;
          }
          return true;
        }
      </script>

    </body>

</html>