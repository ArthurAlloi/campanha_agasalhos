<!DOCTYPE html>
<html lang="pt-br">

<%- include("../partials/head"); %>

<style>

body {
  height: 100%;
  margin: 0;
  overflow:hidden;
  width: 100%;
}

main {
  position: relative;
  height: 100vh;
}


</style>

<body id="page-sollogin-index">
  <%- include("../partials/loader") %>
  <script src="/js/loader.js" defer></script>

  <main>

    <div class="back-button">
      <a href="/">
        <div class="back-button-logo">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
          fill="none" viewBox="0 0 24 24" style="display: inline-block; position: relative;">
              <path fill="#fff" fill-rule="evenodd"
              d="M12 22a1 1 0 0 1-1-1V5.857l-6.223 6.224a1 1 0 0 1-1.415-1.415l7.9-7.9a1 1 0 0 1 1.414 0v.001l7.9 7.9a1 1 0 0 1-1.414 1.414L13 5.919V21a1 1 0 0 1-1 1Z"
              clip-rule="evenodd">
              </path>
          </svg>
        </div>
      </a>
    </div>

    <div class="login-box" id="caixa-login">
      <form id="login" action="/login" method="POST" class="form-cadastro">

      <div class="login-logo-sol">

        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
          <path d="M160 221.5C160 152.2 216.2 96 285.5 96L432 96C449.7 96 464 110.3 464 128C464 145.7 449.7 160 432 160L285.5 160C251.5 160 224 187.5 224 221.5C224 252.5 247.1 278.7 277.9 282.5L370.1 294C432.9 301.9 480 355.2 480 418.5C480 487.8 423.8 544 354.5 544L208 544C190.3 544 176 529.7 176 512C176 494.3 190.3 480 208 480L354.5 480C388.5 480 416 452.5 416 418.5C416 387.5 392.9 361.3 362.1 357.5L269.9 346C207.1 338.1 160 284.8 160 221.5z"/>
        </svg>

        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
          <path d="M320 160C231.6 160 160 231.6 160 320C160 408.4 231.6 480 320 480C408.4 480 480 408.4 480 320C480 231.6 408.4 160 320 160zM544 320C544 443.7 443.7 544 320 544C196.3 544 96 443.7 96 320C96 196.3 196.3 96 320 96C443.7 96 544 196.3 544 320z"/>
        </svg>

        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
          <path d="M224 96C241.7 96 256 110.3 256 128L256 480L448 480C465.7 480 480 494.3 480 512C480 529.7 465.7 544 448 544L224 544C206.3 544 192 529.7 192 512L192 128C192 110.3 206.3 96 224 96z"/>
        </svg>

      </div>

        <div class="login-columns">
                
          <div class="login-column">
              <label for="username" class="login-label">Usuário</label>
              <input type="text" id="cpf" name="cpf" class="input-form-login" required maxlength="11" />
          </div>

          <div class="login-column">
              <label for="password" class="login-label">Senha</label>
              <input type="password" id="password" name="password" class="input-form-login" required />
          </div>
      
      </div>

        <div class="login-footer">
          <input type="submit" id="login-btn" class="login-btn" value="Conectar">
        </div>

        <div class="login-link-Cadastro">
          <a href="/cadastro">Casdastrar</a>
        </div>
          
    <div class="error-space">
      <% if (erro) { %>
        <p class="error" style="color: red; margin-top: 10px; font-weight: bolder;"><%= erro %> </p>
      <% } %>
    </div>

      
      </form>

      
      
    </div>

  </main>

  <script>
  document.addEventListener("DOMContentLoaded", () => {

  gsap.set(".login-box", { opacity: 0, y: 20 });
  gsap.set(".back-button", { opacity: 0, y: -10 });
  gsap.set(".login-logo-sol svg", { opacity: 0, y: 15 });
  gsap.set(".login-column", { opacity: 0, y: 20 });
  gsap.set(".login-footer", { opacity: 0, y: 15 });
  gsap.set(".login-link-Cadastro", { opacity: 0, y: 15 });
  gsap.set(".error", { opacity: 0, y: 15 });

  const tl = gsap.timeline({ ease: "power3.out" });

  tl.to(".login-box", { opacity: 1, y: 0, duration: 0.5 }, "-=0.2")
    .to(".login-logo-sol svg", {
      opacity: 1,
      y: 0,
      duration: 0.35,
      stagger: 0.10
    }, "-=0.3")
    .to(".login-column", {
      opacity: 1,
      y: 0,
      duration: 0.35,
      stagger: 0.12
    }, "-=0.2")
    .to(".login-footer", { opacity: 1, y: 0, duration: 0.30 }, "-=0.25")
    .to(".login-link-Cadastro", { opacity: 1, y: 0, duration: 0.30 }, "-=0.3")
    .to(".back-button", { opacity: 1, y: 0, duration: 0.5,  })
    .to(".error", { opacity: 1, y: 0, duration: 0.3,  });

  });
  </script>


  <script type="text/javascript" src="/static/js/script_bolas.js"></script>
  <canvas class="login-canvas-particles" max-width="100%" height="auto" 
  style="left: 0px; top: 0px; position: absolute;"></canvas>

  <script src="//code.jquery.com/jquery-3.6.1.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.js" integrity="sha512-0XDfGxFliYJPFrideYOoxdgNIvrwGTLnmK20xZbCAvPfLGQMzHUsaqZK8ZoH+luXGRxTrS46+Aq400nCnAT0/w==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

  <script> $('#cpf').mask('000.000.000-00', {reverse: true});</script>

</body>

</html>
