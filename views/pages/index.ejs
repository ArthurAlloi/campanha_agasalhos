      <!-- SOBRE -->
      <section id="sobre" class="fade-in">
        <h2>Sobre</h2>
        <p>
          A SOL – Solidariedade Online é uma plataforma que conecta pessoas, causas e corações dispostos a fazer a diferença.
          Nosso objetivo é divulgar e promover campanhas online de forma simples e acessível, 
          permitindo que qualquer pessoa contribua para gerar impacto positivo na sociedade.
        </p>
      </section>
    
      <!-- CAMPANHAS -->
      <section id="campanhas" class="fade-in">
        <h2>Campanhas Ativas</h2>
        <div class="campanhas">
          <div class="card">
            <h3>Campanha do Agasalho</h3>
            <p>Ajude a aquecer o inverno de famílias em situação de vulnerabilidade.</p>
          </div>
          <div class="card">
            <h3>Doe Alimentos</h3>
            <p>Contribua para garantir refeições dignas para quem mais precisa.</p>
          </div>
          <div class="card">
            <h3>Brinquedos para Todos</h3>
            <p>Leve alegria às crianças neste Natal com sua doação.</p>
          </div>
        </div>
      </section>
    
