<!DOCTYPE html>
<html lang="pt-br">

<%- include("../partials/head"); %>

<style>
  :root {
    --color-error: #e90000;
    --color-off-white: #f0f1fa;
    --color-white: #fff;
    --color-dark-white: #e4e6ef;
    --color-off-white-semi: rgba(240, 241, 250, .7);
    --color-black: #000000;
    --color-green: #c1ff00;
    --color-blue: #1a2ffb;
    --color-red: #ff4c41;
    --color-grey-blue: #2b2e3a;
    --color-dark-blue: #071bdf;
    --color-purple: #8832f7;
    --color-project-details-logo-color: #f0f;
    --grid-space: calc((100% - 11 * var(--grid-gap)) / 12);
    --grid-gap: 2vw;
    --global-border-radius: 20px;
    --base-padding-x: max(5vw, 40px);
    --base-padding-y: clamp(30px, 4vw, 50px);
    --header-color: #0016ec;
    --header-text-color: #000000;
    --project-details-bg: #000;
    --project-details-highlight: #000;
    --project-details-btn-bg: #000;
    --project-details-btn-text: #000;
    --project-details-icon-bg: #000;
    --project-details-icon-color: #000;
    --project-details-text: #000;
    --project-details-btn-bg-hover: #000;
    --project-details-btn-text-hover: #fff;
    --header-size: clamp(1rem, 1vw, 2rem);
    --cross-size: clamp(.875rem, 1vw, 2rem);
  }
</style>
<body>
  <%- include("../partials/menu"); %>

  <!-- HERO SECTION (Lusion style)-->
  <section id="hero" class="section hero">

    <div class="hero-content">

      <!-- WRAPPER TOTAL DO TÍTULO -->
      <h1 class="split-title" data-split>
        Solidariedade Online
      </h1>

      <!-- SUBTÍTULO -->
      <p class="split-subtitle" data-split>
        Criador de campanhas 100% digital, alcançando todas as pessoas do Brasil.
      </p>

      <!-- BOTÃO -->
      <div class="hero-cta fade-in-item">
        <a href="#campanhas" class="btn-primary">Criar campanha</a>
      </div>

    </div>

    <!-- DECORAÇÃO PARA ANIMAÇÃO -->
    <div class="hero-line-wrap">
      <div class="hero-line"></div>
    </div>

  </section>

  <!-- SECTION SOBRE-->
  <section id="sobre" class="section about">

    <div class="about-content">

      <h2 class="split-title" data-split>
        Como funciona o SOL?
      </h2>

      <p class="split-paragraph" data-split>
        A Solidariedade Online facilita a criação de campanhas sociais de maneira simples,
        rápida e totalmente digital. Nossa missão é ampliar o alcance de quem precisa.
      </p>

    </div>

  </section>

  <!-- LISTA DE CAMPANHAS -->
  <section id="campanhas" class="section campaigns">

    <h2 class="split-title" data-split>
      Campanhas em destaque
    </h2>

    <div class="campaigns-grid">

      <div class="campaign-card fade-in-item">
        <h3 class="card-title" data-split>Ajude a ONG Esperança</h3>
        <p class="card-text">
          Apoie crianças em situação de vulnerabilidade oferecendo suporte e educação.
        </p>
      </div>

      <div class="campaign-card fade-in-item">
        <h3 class="card-title" data-split>
          Reforço às famílias carentes
        </h3>
        <p class="card-text">
          Doações para alimentação, higiene e necessidades básicas.
        </p>
      </div>

      <div class="campaign-card fade-in-item">
        <h3 class="card-title" data-split>
          Apoio às vítimas das enchentes
        </h3>
        <p class="card-text">
          Campanha emergencial para ajudar diversas regiões afetadas.
        </p>
      </div>

    </div>

  </section>

  <!-- SCRIPT DE SPLIT E ANIMAÇÕES GSAP-->
  <script>
    // SplitType
    document.querySelectorAll("[data-split]").forEach(el => {
      new SplitType(el, { types: "lines, words" });
    });

    // ANIMAÇÃO LUSION-STYLE
    gsap.registerPlugin(ScrollTrigger);

    // Animações de títulos
    gsap.utils.toArray(".split-title").forEach(title => {
      gsap.from(title.querySelectorAll(".word"), {
        scrollTrigger: {
          trigger: title,
          start: "top 85%",
        },
        opacity: 0,
        y: 40,
        stagger: 0.05,
        duration: 0.6,
        ease: "power2.out"
      });
    });

    // Parágrafos animados
    gsap.utils.toArray(".split-paragraph").forEach(p => {
      gsap.from(p.querySelectorAll(".word"), {
        scrollTrigger: {
          trigger: p,
          start: "top 90%",
        },
        opacity: 0,
        y: 25,
        stagger: 0.02,
        duration: 0.5,
        ease: "power2.out"
      });
    });

    // Cards fade-in
    gsap.utils.toArray(".fade-in-item").forEach(item => {
      gsap.from(item, {
        scrollTrigger: {
          trigger: item,
          start: "top 92%",
        },
        opacity: 0,
        y: 50,
        duration: 0.6,
        ease: "power2.out"
      });
    });

    // Linha azul animada estilo Lusion
    gsap.from(".hero-line", {
      scrollTrigger: {
        trigger: "#hero",
        start: "top top",
        end: "bottom+=200 top",
        scrub: true,
      },
      scaleX: 0,
      transformOrigin: "left center",
      ease: "none"
    });
  </script>

</body>
</html>
