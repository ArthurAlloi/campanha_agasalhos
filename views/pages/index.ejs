<!DOCTYPE html>
<html lang="pt-br" data-theme="light">

<%- include("../partials/head"); %>

  <style>
    :root {
      --color-error: #e90000;
      --color-off-white: #f0f1fa;
      --color-white: #fff;
      --color-dark-white: #e4e6ef;
      --color-off-white-semi: rgba(240, 241, 250, .7);
      --color-black: #000000;
      --color-green: #c1ff00;
      --color-blue: #2b40f8;
      --color-red: #ff4c41;
      --color-grey-blue: #2b2e3a;
      --color-dark-blue: #1e31dd;
      --color-purple: #8832f7;
      --color-project-details-logo-color: #f0f;
      --grid-space: calc((100% - 11 * var(--grid-gap)) / 12);
      --grid-gap: 2vw;
      --global-border-radius: 20px;
      --base-padding-x: max(5vw, 40px);
      --base-padding-y: clamp(30px, 4vw, 50px);
      --header-color: #1e31dd7b;
      --header-text-color: #000000;
      --project-details-bg: #000;
      --project-details-highlight: #000;
      --project-details-btn-bg: #000;
      --project-details-btn-text: #000;
      --project-details-icon-bg: #000;
      --project-details-icon-color: #000;
      --project-details-text: #000;
      --project-details-btn-bg-hover: #000;
      --project-details-btn-text-hover: #fff;
      --header-size: clamp(1rem, 1vw, 2rem);
      --cross-size: clamp(.875rem, 1vw, 2rem)
    }

    /* GLOBAL BODY */
    body {
      margin: 0;
      padding: 0;
      font-family: 'Arial', sans-serif;
      background-color: var(--color-blue);
      color: var(--color-white);
      box-sizing: border-box;
    }

    /* PAGE CONTAINER */
    #page-container {
      padding-left: var(--base-padding-x);
      padding-right: var(--base-padding-x);
      padding-top: var(--base-padding-y);
      padding-bottom: var(--base-padding-y);
    }

    /* HEADER */
    header {
      padding-left: var(--base-padding-x);
      padding-right: var(--base-padding-x);
      padding-top: var(--base-padding-y);
      padding-bottom: var(--base-padding-y);
      background-color: var(--header-color);
      color: var(--header-text-color);
    }

    /* HOME HERO */
    #home-hero {
      margin-top: var(--base-padding-y);
    }

    #home-hero-title {
      margin-left: 0;
      margin-right: 0;
      max-width: 100%;
    }

    #home-hero-title .line {
      margin-bottom: 0.5em;
    }

    /* HOME REEL */
    #home-reel {
      margin-top: var(--base-padding-y);
    }

    #home-reel-title,
    #home-reel-desc {
      margin-left: 0;
      margin-right: 0;
      max-width: 100%;
    }

    /* CTA BUTTON HOME REEL */
    #home-reel-cta {
      display: inline-flex;
      align-items: center;
      margin-top: 1.5em;
      padding: 0.75em 1.5em;
      border-radius: var(--global-border-radius);
      background-color: var(--color-dark-blue);
      color: var(--color-white);
      text-decoration: none;
      font-weight: bold;
      transition: all 0.3s ease;
    }

    #home-reel-cta:hover {
      background-color: var(--color-blue);
    }

    /* CAMPANHAS */
    #campanhas {
      margin-top: var(--base-padding-y);
      margin-left: var(--base-padding-x);
      margin-right: var(--base-padding-x);
    }

    #campanhas .campanhas {
      display: flex;
      flex-wrap: wrap;
      gap: 2vw;
    }

    #campanhas .card {
      background-color: var(--color-dark-blue);
      padding: var(--base-padding-y);
      border-radius: var(--global-border-radius);
      flex: 1 1 calc(33% - 2vw);
      min-width: 250px;
    }

    /* LOCALIZAÇÃO */
    #localizacao {
      margin-top: var(--base-padding-y);
      margin-left: var(--base-padding-x);
      margin-right: var(--base-padding-x);
    }

    #localizacao .map-container {
      margin-top: 1em;
      border-radius: var(--global-border-radius);
      overflow: hidden;
    }

    /* DOAÇÃO */
    #doacao {
      margin-top: var(--base-padding-y);
      margin-left: var(--base-padding-x);
      margin-right: var(--base-padding-x);
      text-align: center;
    }

    #doacao .btn {
      padding: 0.75em 1.5em;
      border-radius: var(--global-border-radius);
      background-color: var(--color-green);
      color: var(--color-black);
      font-weight: bold;
      border: none;
      cursor: pointer;
    }

    #doacao .btn:hover {
      background-color: var(--color-blue);
      color: var(--color-white);
    }

    /* FOOTER */
    footer {
      width: 100%;
      padding-top: var(--base-padding-y);
      padding-bottom: var(--base-padding-y);
      background-color: var(--color-dark-blue);
      color: var(--color-white);
      text-align: center;
      box-sizing: border-box;
    }
  </style>

  <body>

    <div id="ui">

      <%- include("../partials/menu"); %>

        <div id="page-container" style="transform: translate3d(0px, 0px, 0px); opacity: 1;">
          <div id="page-container-inner">
            <div id="home" class="page">

              <!-- HOME HERO -->
              <div id="home-hero" class="section">
                <h1 id="home-hero-title">
                  Nos ajudamos a criar campanhas digitais que se conectam com a sociedade
                </h1>

                <div id="home-hero-visual-container"></div>

                <div id="home-hero-scroll-container">
                  <div id="home-hero-scroll-container-crosses">
                    <div class="home-hero-scroll-container-cross"></div>
                    <div class="home-hero-scroll-container-cross"></div>
                    <div class="home-hero-scroll-container-cross"></div>
                    <div class="home-hero-scroll-container-cross"></div>
                  </div>
                  <div id="home-hero-scroll">scroll para explorar</div>
                </div>
              </div>

              <!-- HOME REEL -->
              <div id="home-reel" class="section">
                <h4 id="home-reel-title">
                  Solidariedade Online – Ajudando Pessoas
                </h4>

                <div id="home-reel-content">
                  <p id="home-reel-desc">
                    Solidariedade Online é uma plataforma 100% digital dedicada à criação e divulgação de campanhas
                    solidárias, conectando pessoas de todo o Brasil em prol de causas que transformam vidas. Aqui,
                    qualquer pessoa pode apoiar, compartilhar ou iniciar uma iniciativa que fará a diferença no país.
                  </p>

                  <div id="home-reel-thumb-wrapper">
                    <div id="home-reel-thumb"></div>
                  </div>
                </div>
                <!-- FECHA HOME HERO -->


                <a id="home-reel-cta" href="/about" target="_blank">
                  <span id="home-reel-cta-dot"></span>
                  <span id="home-reel-cta-text">Sobre</span>
                  <span id="home-reel-cta-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16">
                      <path stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M2.343 8h11.314m0 0L8.673 3.016M13.657 8l-4.984 4.984"></path>
                    </svg>
                  </span>
                </a>
              </div>
            </div> <!-- FECHA HOME REEL -->

            <!-- CAMPANHAS -->
            <br>
            <section id="campanhas" class="fade-in">
              <h2>Campanhas Ativas</h2>
              <div class="campanhas">
                <div class="card">
                  <h3>Campanha do Agasalho</h3>
                  <p>Ajude a aquecer o inverno de famílias em situação de vulnerabilidade.</p>
                </div>
                <div class="card">
                  <h3>Doe Alimentos</h3>
                  <p>Contribua para garantir refeições dignas para quem mais precisa.</p>
                </div>
                <div class="card">
                  <h3>Brinquedos para Todos</h3>
                  <p>Leve alegria às crianças neste Natal com sua doação.</p>
                </div>
              </div>
            </section>

            <!-- LOCALIZAÇÃO -->
            <section id="localizacao" class="fade-in">
              <h2>Localização</h2>
              <p>Unidade do SENAI “Dr. Celso Charuri” – Av. Rebouças, 3965 - Jardim São Carlos, Sumaré - SP, 13170-023
              </p>
              <div class="map-container">
                <iframe
                  src="https://www.google.com/maps?q=Av.+Rebou%C3%A7as,+3965+-+Jardim+S%C3%A3o+Carlos,+Sumar%C3%A9+-+SP,+13170-023&output=embed"
                  loading="lazy"></iframe>
              </div>
            </section>

            <!-- DOAÇÃO -->
            <section id="doacao" class="fade-in">
              <h2>Faça uma Doação</h2>
              <p>Transforme pequenos gestos em grandes mudanças. Toda contribuição conta!</p>
              <a href="/login" class="btn" style="display:inline-block; text-decoration:none;">
                Doar Agora
              </a>
            </section>

          </div> <!-- FECHA HOME -->
        </div> <!-- FECHA PAGE CONTAINER INNER -->
    </div> <!-- FECHA PAGE CONTAINER -->

    <!-- FOOTER FORA DO CONTAINER -->
    <%- include("../partials/footer"); %>

      </div> <!-- FECHA UI -->

      <script type="module" src="/static/js/home-hero-visual.js"></script>

  </body>

</html>