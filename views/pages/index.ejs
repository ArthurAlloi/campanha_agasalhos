<!DOCTYPE html>
<html lang="pt-br" data-theme="light">

<%- include("../partials/head"); %>

  <style>
  /* Variáveis e Configurações Globais (Mantidas) */
  :root {
    --color-error: #e90000;
    --color-off-white: #f0f1fa;
    --color-white: #fff;
    --color-dark-white: #e4e6ef;
    --color-off-white-semi: rgba(240, 241, 250, .7);
    --color-black: #000000;
    --color-green: #c1ff00;
    --color-blue: #2b40f8;
    --color-red: #ff4c41;
    --color-grey-blue: #2b2e3a;
    --color-dark-blue: #1e31dd;
    --color-purple: #8832f7;
    --color-project-details-logo-color: #f0f;
    --grid-space: calc((100% - 11 * var(--grid-gap)) / 12);
    --grid-gap: 2vw;
    --global-border-radius: 20px;
    --base-padding-x: max(5vw, 40px);
    --base-padding-y: clamp(30px, 4vw, 50px);
    --header-color: #1e31dd7b;
    --header-text-color: #000000;
    --project-details-bg: #000;
    --project-details-highlight: #000;
    --project-details-btn-bg: #000;
    --project-details-btn-text: #000;
    --project-details-icon-bg: #000;
    --project-details-icon-color: #000;
    --project-details-text: #000;
    --project-details-btn-bg-hover: #000;
    --project-details-btn-text-hover: #fff;
    --header-size: clamp(1rem, 1vw, 2rem);
    --cross-size: clamp(.875rem, 1vw, 2rem)
  }

  /* Reset Básico e Layout */
  body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  #page-container {
    margin: 0;
    padding: 0;
  }

  .section {
    margin: 0 auto;
    padding: var(--base-padding-y) var(--base-padding-x); /* Uso de variáveis para padding base */
    max-width: 1200px;
  }

  /* Estilos Comuns das Novas Seções (Agrupamento e Otimização) */
  #campanhas, #localizacao, #doacao {
    padding-block: clamp(40px, 8vw, 80px); /* Padding vertical responsivo */
    padding-inline: var(--base-padding-x);
    margin: 0 auto;
    max-width: 1200px;
  }

  #campanhas h2, #localizacao h2, #doacao h2 {
    text-align: center;
    margin-block-end: 30px; /* Uso de margin-block-end */
    font-size: 2rem;
    color: var(--color-dark-blue);
  }

  /* Estilos de Campanhas */
  .campanhas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-block: 30px;
    list-style: none; /* Adicionado para a lista não ter marcadores */
    padding: 0; /* Remove padding padrão do ul */
  }

  .card {
    background: var(--color-white);
    border-radius: var(--global-border-radius);
    padding: 25px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    border: 1px solid var(--color-dark-white);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
  }

  .card h3 {
    color: var(--color-dark-blue);
    margin-block-end: 15px;
    font-size: 1.3rem;
  }

  .card p {
    color: var(--color-grey-blue);
    line-height: 1.6;
  }

  /* Estilos de Localização (Mapa) */
  .map-container {
    margin-block: 30px;
    border-radius: var(--global-border-radius);
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }

  .map-container iframe {
    width: 100%;
    height: 400px;
    border: none;
    display: block; /* Garante que o iframe ocupe todo o espaço */
  }

  /* Botão Padrão */
  .btn {
    background: var(--color-blue);
    color: var(--color-white);
    padding: 15px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: bold;
    display: inline-block;
    transition: all 0.3s ease;
    border: 2px solid var(--color-blue);
    /* margin-top: 20px; Removido para ser aplicado no elemento específico */
  }

  .btn:hover {
    background: var(--color-dark-blue);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(43, 64, 248, 0.3);
  }

  /* Animação */
  .fade-in {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 0.8s ease forwards paused; /* Adicionado 'paused' */
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

 

  /* Correção HOME HERO */
  #home-hero {
    padding: 80px var(--base-padding-x);
    text-align: center;
  }

  #home-hero-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.2;
    margin-block-end: 40px;
    color: var(--color-dark-blue);
  }

  /* Correção HOME REEL */
  #home-reel {
    background: var(--color-off-white);
    border-radius: var(--global-border-radius);
    margin-block: 40px;
    padding: 40px; /* Adicionado padding interno */
  }
  
  #home-reel-title {
    margin-block-end: 15px;
    font-size: 1.2rem;
    color: var(--color-dark-blue);
  }

  #home-reel-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-block-start: 30px;
    text-decoration: none;
    color: var(--color-blue);
    font-weight: bold;
    transition: color 0.3s ease;
  }

  #home-reel-cta:hover {
    color: var(--color-dark-blue);
  }

  /* Botões específicos */
  .card .btn {
      margin-block-start: 15px;
  }
  
  #doacao .btn {
      margin-block-start: 20px;
  }
  
  /* Estilo do link de login na seção Doação */
  #doacao p:last-child {
      margin-block-start: 15px;
  }

</style>

  <body>

