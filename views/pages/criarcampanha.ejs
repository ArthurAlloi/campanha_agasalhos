<!DOCTYPE html>
<html lang="pt-br">
  <%- include("../partials/head"); %>

  <body>
    <%- include("../partials/loader") %>
    <script src="/js/loader.js" defer></script>
    <%- include("../partials/menu"); %>

    <div id="header-space"></div>

    <main class="page-campanha solu-main">

      <% if (sucesso) { %>
        <div class="alert alert-success"><%= sucesso %></div>
      <% } %>
      <% if (erro) { %>
        <div class="alert alert-error"><%= erro %></div>
      <% } %>

      <!-- MANTIVE o novalidate porque você usava validação própria -->
      <form id="form-campanha" class="form-campanha" action="/criarcampanha" method="POST" novalidate>
        <h1 class="page-title">Criar Campanha</h1>

        <!-- Nome da campanha -->
        <label for="campanha-nome" class="form-label">Nome da Campanha</label>
        <input id="campanha-nome" class="input" type="text" name="nome" maxlength="40" required placeholder="Ex: Campanha do Agasalho">

        <!-- Descrição -->
        <label for="campanha-descricao" class="form-label">Descrição</label>
        <textarea id="campanha-descricao" class="textarea" name="descricao" maxlength="300" rows="3" placeholder="Descrição da campanha (até 300 caracteres)"></textarea>

        <!-- Datas -->
        <div class="form-row">
          <div class="form-col">
            <label for="campanha-inicio" class="form-label">Data de Início</label>
            <input id="campanha-inicio" class="input" type="date" name="data_inicio" required>
          </div>

          <div class="form-col">
            <label for="campanha-fim" class="form-label">Data de Término</label>
            <input id="campanha-fim" class="input" type="date" name="data_fim" required>
          </div>
        </div>

        <hr class="sep">

        <!-- Itens -->
        <h2 class="subheading">Itens da Campanha</h2>

        <div class="preview-and-items">
          <div class="items-col">
            <div id="itens-container" class="items-container" aria-live="polite">
              <div class="item-row">
                <input class="input item-input item-nome" type="text" name="nome_item[]" maxlength="30" placeholder="Nome do item" required>
                <input class="input item-input item-pontos" type="number" name="pontos[]" min="1" max="99" placeholder="Pontos" required>
                <button type="button" class="btn btn-remove" aria-label="Remover item" hidden>Remover</button>
              </div>
            </div>

            <div class="form-actions">
              <button type="button" id="btn-add-item" class="btn btn-secondary">+ Adicionar Item</button>
              <button type="submit" id="btn-submit-campanha" class="btn btn-primary">Criar Campanha</button>
            </div>
          </div>
        </div>
      </form>
    </main>

    <div id="header-space"></div>

    <script>
      (function () {
        const form = document.getElementById('form-campanha');
        const nomeInput = document.getElementById('campanha-nome');
        const descInput = document.getElementById('campanha-descricao');
        const inicio = document.getElementById('campanha-inicio');
        const fim = document.getElementById('campanha-fim');
        const itensContainer = document.getElementById('itens-container');
        const btnAdd = document.getElementById('btn-add-item');

        // definir min da data inicial para hoje
        const hoje = new Date().toISOString().split('T')[0];
        inicio.min = hoje;
        fim.min = hoje;

        // impedir números no nome da campanha
        nomeInput.addEventListener('input', () => {
          nomeInput.value = nomeInput.value.replace(/[0-9]/g, '');
        });

        // função que ativa comportamentos nos itens
        function attachItemBehaviors(container) {
          container.querySelectorAll('.item-nome').forEach(el => {
            el.addEventListener('input', () => el.value = el.value.replace(/[0-9]/g, ''));
          });
          container.querySelectorAll('.btn-remove').forEach(btn => {
            btn.addEventListener('click', () => btn.closest('.item-row').remove());
          });
        }

        // criar novo item dinamicamente
        function criarItemRow() {
          const row = document.createElement('div');
          row.className = 'item-row';
          row.innerHTML = `
            <input class="input item-input item-nome" type="text" name="nome_item[]" maxlength="30" placeholder="Nome do item" required>
            <input class="input item-input item-pontos" type="number" name="pontos[]" min="1" max="99" placeholder="Pontos" required>
            <button type="button" class="btn btn-remove">Remover</button>
          `;
          attachItemBehaviors(row);
          return row;
        }

        btnAdd.addEventListener('click', () => {
          const row = criarItemRow();
          itensContainer.appendChild(row);
          itensContainer.querySelectorAll('.btn-remove').forEach(btn => btn.hidden = false);
          row.querySelector('.item-nome').focus();
        });

        attachItemBehaviors(itensContainer);

        // 🔥 VALIDAÇÃO COMPLETA CORRIGIDA
        form.addEventListener('submit', function (e) {
          const vInicio = inicio.value;
          const vFim = fim.value;

          // 1️⃣ validar se datas estão vazias
          if (!vInicio || !vFim) {
            e.preventDefault();
            alert('Preencha as duas datas antes de criar a campanha.');
            return false;
          }

          // 2️⃣ validar ordem das datas
          if (vFim < vInicio) {
            e.preventDefault();
            alert('A data de término não pode ser ANTES da data de início.');
            return false;
          }

          // 3️⃣ validar pontos dos itens
          const pontos = Array.from(form.querySelectorAll('.item-pontos')).map(i => Number(i.value));
          for (let p of pontos) {
            if (!Number.isFinite(p) || p < 1 || p > 99) {
              e.preventDefault();
              alert('Cada item deve ter entre 1 e 99 pontos.');
              return false;
            }
          }

          return true;
        });

        // permite adicionar item com Enter no nome
        itensContainer.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && e.target.matches('.item-nome')) {
            e.preventDefault();
            btnAdd.click();
          }
        });
      })();
    </script>

    <script src="/static/js/main.js"></script>

  </body>
</html>