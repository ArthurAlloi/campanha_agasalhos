<!DOCTYPE html>
<html lang="pt-br">
  <%- include("../partials/head"); %>

  <body>
    <%- include("../partials/menu"); %>

    <main class="page-campanha">

      <% if (sucesso) { %>
        <div class="alert alert-success"><%= sucesso %></div>
      <% } %>
      <% if (erro) { %>
        <div class="alert alert-error"><%= erro %></div>
      <% } %>
      <form action="/criarcampanha" id="form-campanha" method="POST" class="form-campanha" onsubmit="return validarFormulario()">
      
      	<div class="page-header">
          <h1 class="page-title">Criar Nova Campanha</h1>
        </div>
      
      	<!-- Nome da campanha -->
        <label for="campanha-nome" class="form-label">Nome da Campanha:</label>
        <input type="text"
               name="nome"
               id="nomeCampanha"  id="campanha-nome" class="input"
               maxlength="40"
               required
               placeholder="Ex: Campanha do Agasalho">
      
        <!-- Descrição -->
        <label for="campanha-descricao" class="form-label">Descrição:</label>
        <textarea name="descricao"
                  id="descricaoCampanha"   id="campanha-descricao" class="input textarea"
                  maxlength="300"
                  rows="3"
                  placeholder="Descrição da campanha (até 300 caracteres)">
        </textarea>
      
        <!-- Datas -->
      	<div class="form-row">
      		<div class="form-col">
              	<label for="campanha-inicio" class="form-label">Data de Início:</label>
              	<input type="date" name="data_inicio" id="inicio" required> <!--<input id="campanha-inicio" class="input"-->
      		</div>
      		<div class="form-col">
              	<label for="campanha-fim" class="form-label">Data de Término:</label>
              	<input type="date" name="data_fim" id="fim" required> <!--id="campanha-fim" class="input"-->
          
              <hr>
          
              <!-- Itens -->
              <h3>Itens da Campanha</h3>
              <div id="itens-container">
                <div class="item" style="display:flex; gap:10px; margin-bottom:5px;">
                  <input type="text"
                         name="nome_item[]"
                         class="itemNome"
                         maxlength="30"
                         placeholder="Nome do item"
                         required>
                  <input type="number"
                         name="pontos[]"
                         min="1"
                         max="99"
                         placeholder="Pontos"
                         required>
                
                </div>
              </div>
            
              <hr class="sep">
            
              <h2 class="subheading">Itens da Campanha</h2>
            
              <div id="campanha-items" class="items-container" aria-live="polite">
                <div class="item-row">
                  <input class="input item-input" type="text" name="nome_item[]" placeholder="Nome do item" required>
                  <input class="input item-input" type="number" name="pontos[]" placeholder="Pontos" required>
                </div>
              </div>
            
              <div class="form-actions">
                <button type="button" id="btn-add-item" class="btn btn-secondary">+ Adicionar Item</button>
                <button type="submit" id="btn-submit-campanha" class="btn btn-primary">Criar Campanha</button>
              </div>
      </form>
    </main>

    <script>
      // Impedir números no nome da campanha
      document.getElementById("nomeCampanha").addEventListener("input", function () {
        this.value = this.value.replace(/[0-9]/g, "");
      });

      // Impedir números nos nomes dos itens
      function bloquearNumerosItens() {
        document.querySelectorAll(".itemNome").forEach(campo => {
          campo.addEventListener("input", function () {
            this.value = this.value.replace(/[0-9]/g, "");
          });
        });
      }
      bloquearNumerosItens();

      // Adicionar item
      function adicionarItem() {
        const container = document.getElementById('itens-container');
        const novoItem = document.createElement('div');
        novoItem.classList.add('item');
        novoItem.style.display = "flex";
        novoItem.style.gap = "10px";
        novoItem.style.marginBottom = "5px";
        novoItem.innerHTML = `
          <input type="text"
                 name="nome_item[]"
                 class="itemNome"
                 maxlength="30"
                 placeholder="Nome do item"
                 required>

          <input type="number"
                 name="pontos[]"
                 min="1"
                 max="99"
                 placeholder="Pontos"
                 required>

          <button type="button" onclick="this.parentElement.remove()">Remover</button>
        `;

        container.appendChild(novoItem);
        bloquearNumerosItens();
      }

      // Validação de datas
      function validarFormulario() {
        const inicio = document.getElementById("inicio").value;
        const fim = document.getElementById("fim").value;

        if (fim < inicio) {
          alert("A data de término não pode ser ANTES da data de início.");
          return false;
        }

        return true;
      }
    </script>
  </body>
</html>
