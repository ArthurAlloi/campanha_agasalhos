<!DOCTYPE html>
<html lang="pt-br">
  <%- include("../partials/head"); %>

  <body>
    <%- include("../partials/menu"); %>

    <main class="page-campanha">

      <% if (sucesso) { %>
        <div class="alert alert-success"><%= sucesso %></div>
      <% } %>
      <% if (erro) { %>
        <div class="alert alert-error"><%= erro %></div>
      <% } %>

      <form id="form-campanha" class="form-campanha" action="/criarcampanha" method="POST" novalidate>
        <div class="page-header">
          <h1 class="page-title">Criar Nova Campanha</h1>
        </div>
        
        <label for="campanha-nome" class="form-label">Nome da Campanha</label>
        <input id="campanha-nome" class="input" type="text" name="nome" required>

        <label for="campanha-descricao" class="form-label">Descrição</label>
        <textarea id="campanha-descricao" class="input textarea" name="descricao" rows="3"></textarea>

        <div class="form-row">
          <div class="form-col">
            <label for="campanha-inicio" class="form-label">Data de Início</label>
            <input id="campanha-inicio" class="input" type="date" name="data_inicio" required>
          </div>

          <div class="form-col">
            <label for="campanha-fim" class="form-label">Data de Término</label>
            <input id="campanha-fim" class="input" type="date" name="data_fim" required>
          </div>
        </div>

        <hr class="sep">

        <h2 class="subheading">Itens da Campanha</h2>

        <div id="campanha-items" class="items-container" aria-live="polite">
          <div class="item-row">
            <input class="input item-input" type="text" name="nome_item[]" placeholder="Nome do item" required>
            <input class="input item-input" type="number" name="pontos[]" placeholder="Pontos" required>
          </div>
        </div>

        <div class="form-actions">
          <button type="button" id="btn-add-item" class="btn btn-secondary">+ Adicionar Item</button>
          <button type="submit" id="btn-submit-campanha" class="btn btn-primary">Criar Campanha</button>
        </div>
      </form>
    </main>

    <script>
      (function () {
        const container = document.getElementById('campanha-items');
        const btnAdd = document.getElementById('btn-add-item');

        function criarItemRow() {
          const row = document.createElement('div');
          row.className = 'item-row';
          row.innerHTML = `
            <input class="input item-input" type="text" name="nome_item[]" placeholder="Nome do item" required>
            <input class="input item-input" type="number" name="pontos[]" placeholder="Pontos" required>
            <button type="button" class="btn btn-remove" aria-label="Remover item">Remover</button>
          `;
          // delega evento de remoção
          row.querySelector('.btn-remove').addEventListener('click', () => row.remove());
          return row;
        }

        btnAdd.addEventListener('click', () => {
          container.appendChild(criarItemRow());
          container.lastElementChild.querySelector('.item-input').focus();
        });

        // acessibilidade: permitir adicionar item com Enter quando foco estiver no último campo
        container.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && e.target.matches('.item-input')) {
            e.preventDefault();
            btnAdd.click();
          }
        });
      })();
    </script>
  </body>
</html>
