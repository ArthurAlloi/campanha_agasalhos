<!DOCTYPE html>
<html lang="pt-br">
  <%- include("../partials/head"); %>
 
  <body>
    <%- include("../partials/loader") %>
    <script src="/js/loader.js" defer></script>
    <%- include("../partials/menu"); %>

    <div id="header-space"></div>

    <main class="page-campanhas solu-main">

      <div class="table-wrap">
        <table class="table-campanhas" id="table-campanhas" cellpadding="0" cellspacing="0" role="table">
          <h1 class="page-title">Campanhas</h1>
          <thead>
            <tr>
              <th scope="col">Nome da Campanha</th>
              <th scope="col">Descrição</th> <!-- 🆕 COLUNA -->
              <th scope="col">Data de Início</th>
              <th scope="col">Data de Término</th>
              <th scope="col">Status</th>
              <th scope="col">Tempo Restante</th>
              <th scope="col">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (campanhas.length > 0) { %>
              <% campanhas.forEach(c => { %>
                <tr class="campanha-row <%= c.ativa ? 'campanha-ativa' : 'campanha-encerrada' %>">

                  <td class="cell-name"><%= c.nome %></td>

                  <!-- 🆕 CÉLULA DE DESCRIÇÃO -->
                  <td class="cell-description" style="max-width: 250px; word-wrap: break-word;">
                    <%= c.descricao && c.descricao.trim() !== ""
                          ? c.descricao
                          : "Sem descrição"
                    %>
                  </td>

                  <td class="cell-start"><%= c.data_inicio %></td>
                  <td class="cell-end"><%= c.data_fim %></td>

                  <td class="cell-status">
                    <span class="campanha-status <%= c.ativa ? 'status-ativa' : 'status-encerrada' %>">
                      <%= c.ativa ? 'Ativa' : 'Encerrada' %>
                    </span>
                  </td>

                  <td class="cell-timer">
                    <span class="campanha-timer" data-fim="<%= c.data_fim %>"></span>
                  </td>

                  <td class="cell-actions">
                    <form action="/campanhas/<%= c.id %>" method="GET" class="action-form">
                      <button class="btn btn-primary btn-view" <%= c.ativa ? '' : 'disabled' %>>Ver mais</button>
                    </form>
                  </td>

                </tr>
              <% }) %>

            <% } else { %>
              <tr><td colspan="7" class="empty">Nenhuma campanha cadastrada 😕</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </main>

    <div id="header-space"></div>

    <script>
      (function () {
        const timers = document.querySelectorAll('.campanha-timer');

        function atualizarTimers() {
          const agora = new Date();
          timers.forEach(timerEl => {
            const fim = new Date(timerEl.dataset.fim);
            const tr = timerEl.closest('tr');

            if (isNaN(fim)) {
              timerEl.textContent = '—';
              return;
            }

            let diff = fim - agora;

            if (diff <= 0) {
              timerEl.textContent = '0d 0h 0m';
              tr.classList.remove('campanha-alerta');
              return;
            }

            const dias = Math.floor(diff / (1000*60*60*24));
            const horas = Math.floor((diff % (1000*60*60*24)) / (1000*60*60));
            const minutos = Math.floor((diff % (1000*60*60)) / (1000*60));

            timerEl.textContent = `${dias}d ${horas}h ${minutos}m`;

            if (dias <= 3) {
              tr.classList.add('campanha-alerta');
            } else {
              tr.classList.remove('campanha-alerta');
            }
          });
        }

        atualizarTimers();
        setInterval(atualizarTimers, 60000);
      })();
    </script>

    <script src="/static/js/main.js"></script>
   
  </body>
</html>