<!DOCTYPE html>
<html lang="pt-br">
  <%- include("../partials/head"); %>
  <body>
    <%- include("../partials/menu"); %>

    <main class="solu-main">
      <h1>Campanhas</h1>

      <table class="solu-table" id="tabela-campanhas">
        <thead>
          <tr>
            <th>Nome da Campanha</th>
            <th>Data de Início</th>
            <th>Data de Término</th>
            <th>Status</th>
            <th>Tempo Restante</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if (campanhas.length > 0) { %>
            <% campanhas.forEach(c => { %>
              <tr data-id="<%= c.id %>">
                <td><%= c.nome %></td>
                <td><%= new Date(c.data_inicio).toLocaleDateString('pt-BR') %></td>
                <td><%= new Date(c.data_fim).toLocaleDateString('pt-BR') %></td>

                <td class="status <%= c.ativa ? 'ativa' : 'encerrada' %>">
                  <%= c.ativa ? 'Ativa ✅' : 'Encerrada ❌' %>
                </td>

                <td class="timer" data-fim="<%= c.data_fim %>"></td>

                <td>
                  <form action="/campanhas/<%= c.id %>" method="GET">
                    <button class="btn-ver" <%= c.ativa ? '' : 'disabled' %>>Ver mais</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="6">Nenhuma campanha cadastrada 😕</td></tr>
          <% } %>
        </tbody>
      </table>
    </main>

    <script src="https://apis.google.com/js/api.js"></script>
    <script src="/js/timerAPI.js"></script>
  </body>
</html>
