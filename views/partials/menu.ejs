<header>
  <nav class="navbar"> 
    <div class="components-menu">
      
      <!-- LOGO -->
      <div class="components-menu-logo">
        <a href="/">
          <div class="titulo-container">
            <img src="../static/Img/Logo_two.png" alt="Logo da Campanha" id="logoimg" />
            <div class="tit">SOL</div>
          </div>
        </a>
      </div>

      <!-- LINKS CENTRAIS -->
      <div class="components-menu-center">
        <ul class="nav-links">
          <li><a href="#home">HOME</a></li>
          <li><a href="#campanhas">SOBRE</a></li>
          <li><a href="#">FAQ</a></li>
          
          <li>
            <% if (!req.session.user) { %>
              <a href="/doacoes_doaruser" value="Doações">CAMPANHAS</a>
            <% } else { %>
              <a href="/doacoes_doaruser" value="Doações/Doar">CAMPANHAS</a>
            <% } %>
          </li>

          <!-- LINKS EXCLUSIVOS PARA ADMIN -->
          <% if (req.session.user && req.session.user.adm === 1) { %>
            <li><a href="/criarcampanha" value="Campanha">CRIAR CAMPANHAS</a></li>
            <li><a href="/usuariosadm" value="Usuários">USUÁRIOS</a></li>
          <% } %>
        </ul>
      </div>

      <!-- LOGIN / LOGOUT -->
      <div class="components-menu-right">
        <ul class="login-links">
          <% if (!req.session.user) { %>
            <li><a href="/cadastro" value="Cadastro">CADASTRO</a></li>
            <li><a href="/login" value="Login">LOGIN</a></li>
          <% } else { %>
            <li><a href="/logout" value="Logout">LOGOUT</a></li>
          <% } %>
        </ul>
      </div>

      <!-- BOTÃO MOBILE -->
      <div class="components-menu-toggle" onclick="toggleMenu()">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </div>

    </div>   
  </nav>
</header>

<!-- Espaço automático que impede sobreposição -->
<div id="header-space"></div>
