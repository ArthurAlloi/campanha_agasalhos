<header>
  <nav class="navbar"> 
    <div class="components-menu">
      
      <!-- LOGO -->
      <div class="components-menu-logo">
        <a href="/">
          <div class="titulo-container">
            <img src="../static/Img/Logo_two.png" alt="Logo da Campanha" id="logoimg" />
            <div class="tit">SOL</div>
          </div>
        </a>
      </div>

      <!-- LINKS CENTRAIS -->
      <div class="components-menu-center">
        <ul class="nav-links">
          <li><a href="#home">HOME</a></li>
          <li><a href="#campanhas">SOBRE</a></li>
          <li><a href="#">FAQ</a></li>
          
          <!-- CAMPANHAS PARA TODOS -->
          <li><a href="/tabela">CAMPANHAS</a></li>

          <!-- LINKS EXCLUSIVOS PARA ADMIN -->
          <% if (req.session.user && req.session.user.adm === 1) { %>
            <li><a href="/criarcampanha">CRIAR CAMPANHAS</a></li>
            <li><a href="/usuariosadm">USUÁRIOS</a></li>
            <li><a href="/doacoes_doar">OPÇÕES ADM</a></li>
          <% } %>

          <!-- LINKS PARA MINI ADMIN -->
          <% if (req.session.user && req.session.user.adm === 2) { %>
            <li><a href="/realizardoacaocamp">REALIZAR DOAÇÃO</a></li>
          <% } %>
        </ul>
      </div>

      <!-- LOGIN / LOGOUT -->
      <div class="components-menu-right">
        <ul class="login-links">
          <% if (!req.session.user) { %>
            <li><a href="/cadastro">CADASTRO</a></li>
            <li><a href="/login">LOGIN</a></li>
          <% } else { %>
            <li><a href="/logout">LOGOUT</a></li>
          <% } %>
        </ul>
      </div>

      <!-- BOTÃO MOBILE -->
      <div class="components-menu-toggle" onclick="toggleMenu()">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </div>

    </div>   
  </nav>
</header>

<!-- Espaço automático que impede sobreposição -->
<div id="header-space"></div>
