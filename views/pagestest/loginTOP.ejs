                    <input type="text" name="username" class="login-input" id="username">
                </div>

                <div class="login-column">
                    <label for="password" class="login-label">Senha</label>
                    <input type="password" name="password" id="password" class="login-input">
                    <span toggle="#password" class="fa fa-fw toggle-password fa-eye"></span>
                </div>
            
            </div>
            
            <div class="login-footer">
                <input type="submit" id="loginbtn" class="login-btn" value="Conectar">
            </div>
            
            <a class="login-reset-password" href="/local/recuperarsenha/index.php">
